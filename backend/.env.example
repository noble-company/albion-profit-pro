ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://profitpro:profitpro@localhost:5433/profitpro
# Em Swarm, use DATABASE_URL_FILE apontando para um secret com a URL completa.
REDIS_URL=redis://localhost:6380/0
# Em produção: CIDRs exatos da rede overlay/peers do Traefik. Nunca use 0.0.0.0/0.
TRUSTED_PROXY_CIDRS=[]
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
# REDIS_URL_FILE e RABBITMQ_URL_FILE seguem a mesma convenção no stack de produção.
JWT_SECRET=troque-por-um-segredo-forte-gerado-com-openssl-rand-hex-32
JWT_LIFETIME_SECONDS=3600
# Opcionais — se não setados, os fluxos de reset de senha/verificação de e-mail reusam
# JWT_SECRET. Setar em produção pra poder rotacionar independente do JWT de sessão.
# RESET_PASSWORD_TOKEN_SECRET=
# VERIFICATION_TOKEN_SECRET=
# Com ENVIRONMENT != development, o Settings rejeita "*" e origens sem esquema — precisa ser
# uma origem completa, ex: ["https://app.seu-dominio.com"].
CORS_ORIGINS=["http://localhost:5173"]
PRICE_FRESHNESS_HOURS=6

# Poller da API pública do Albion Data Project (task 4/04). Dá LARGURA de cobertura: preço de
# item que nenhum usuário nosso abriu no jogo. Não dá frescor (mediana medida de 7 h) — a regra
# de precedência do price_snapshot garante que ele nunca sobrescreva dado mais novo do client.
# Desligue em ambiente sem egress.
AODP_ENABLED=true
AODP_BASE_URL_TEMPLATE=https://{realm}.albion-online-data.com
AODP_REALMS=["west"]
