ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://profitpro:profitpro@localhost:5433/profitpro
REDIS_URL=redis://localhost:6380/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
JWT_SECRET=troque-por-um-segredo-forte-gerado-com-openssl-rand-hex-32
JWT_LIFETIME_SECONDS=3600
# Opcionais — se não setados, os fluxos de reset de senha/verificação de e-mail reusam
# JWT_SECRET. Setar em produção pra poder rotacionar independente do JWT de sessão.
# RESET_PASSWORD_TOKEN_SECRET=
# VERIFICATION_TOKEN_SECRET=
# Em produção, precisa conter o domínio real do frontend (não localhost).
CORS_ORIGINS=["http://localhost:5173"]
PRICE_FRESHNESS_HOURS=6
